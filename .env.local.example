# ── Aprimo connection ──────────────────────────────────────────────
# Environment subdomain and the client id of a PKCE registration
# (Authorization Code with PKCE) whose redirect URI includes
#   https://<your-site>/oauth/callback
# With both set, Report Labs connects automatically. Without them, users add
# environments in the Connect dialog.
NEXT_PUBLIC_APRIMO_ENVIRONMENT="your-environment"
NEXT_PUBLIC_APRIMO_CLIENT_ID="your-client-id"

# Client secret for that registration. Server-side only; it is never sent
# to the browser. Leave unset if the registration has no secret.
APRIMO_CLIENT_SECRET="your-client-secret"

# ── Assistant ──────────────────────────────────────────────────────
# Required only for the "Ask a question" panel. Standard reports work
# without it. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional model override (defaults to claude-opus-5).
#REPORT_LABS_MODEL=

# ── Editor Tools link (optional) ───────────────────────────────────
# Base URL of an Aprimo Editor Tools deployment. Adds "Resolve in Editor
# Tools" to the Duplicates report.
#NEXT_PUBLIC_EDITOR_TOOLS_URL="https://virani-editor-tools.vercel.app"
